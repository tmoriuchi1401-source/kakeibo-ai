GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
SPREADSHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# GitHub Actionsでは GOOGLE_SERVICE_ACCOUNT_JSON をSecretに入れても可
RECEIPT_DRIVE_FOLDER_ID=your_drive_receipt_inbox_folder_id
PAYPAY_DRIVE_FOLDER_ID=your_drive_paypay_csv_folder_id
PROCESSED_DRIVE_FOLDER_ID=
BACKUP_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_TOKEN_FILE=drive-backup-token.json
# GitHub Actionsではファイル内容を GOOGLE_DRIVE_BACKUP_TOKEN_JSON Secretへ設定
GOOGLE_DRIVE_BACKUP_TOKEN_JSON=
RECONCILIATION_LOOKBACK_MONTHS=6
# Gmail APIの読み取り専用OAuth authorized-user JSON。サービスアカウントJSONとは別物。
GOOGLE_GMAIL_TOKEN_JSON=
AUPAY_GMAIL_QUERY=in:anywhere from:info@wallet.auone.jp subject:"【au PAY】ご利用のお知らせ" "メールコードP1002" newer_than:30d
# au PAYカード利用詳細メールだけを対象にする読み取り専用Gmail検索式。
# 実運用で送信元・件名が異なる場合は、対象を広げずにこの値を更新する。
AUPAY_CARD_GMAIL_QUERY=in:anywhere from:info@kddi-fs.com subject:"【ご利用詳細】au PAY カード" newer_than:30d
